# Foundation — assumes a fresh CachyOS install with NO desktop selected.
# Everything here is repo-only (--needed makes re-runs free).

# --- Network / remote ---
networkmanager
openssh
tailscale
# syncthing: replicates ~/notes (Obsidian vault) between machines over the
# tailnet. Bootstrap enables the per-user unit; GUI at http://127.0.0.1:8384.
syncthing

# --- Shell + core CLI ---
zsh
git
curl
wget
rsync
man-db
less

# --- Shell UX (zshrc integrates these; each no-ops if absent) ---
starship
zoxide
eza
fzf
# fzf preview renderer for `notes find` / `notes grep` (notes.zsh falls back to
# cat without it, losing highlighting but nothing else).
bat

# --- System plumbing ---
base-devel
pacman-contrib
# paru: the AUR helper. bootstrap installs it anyway (ensure_aur_helper), but
# the bar shells out to it too -- `paru -Qua` for the AUR update count, and the
# tools menu opens `kitty -e paru`. Undeclared it showed up as drift forever.
paru
# pciutils: bootstrap's resolve_kernel_packages reads `lspci` vendor IDs to
# decide whether this machine wants NVIDIA kernel modules. It usually arrives
# as someone else's dependency; declared here so that stays true.
pciutils
xdg-utils
xdg-user-dirs
yadm
