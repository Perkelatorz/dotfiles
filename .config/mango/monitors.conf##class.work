# -----------------------------------------------------
# Monitors – work box (caleb-dev), ported from Hyprland monitors.conf##class.work
# -----------------------------------------------------
# Keep in sync with ~/.config/hypr/monitors.conf (regenerated by nwg-displays).
# Hyprland layout this mirrors:
#   monitor=DP-3,3840x2160@60.0,4422x310,1.25,bitdepth,10
#   monitor=DP-4,3840x2160@60.0,1350x310,1.25,bitdepth,10
#   monitor=DP-1,1920x1080@60.0,0x0,0.8,bitdepth,10  +  transform,1
#
# rr = transform (0 none, 1 = 90° CCW). Never use negative x/y — XWayland
# mis-routes clicks on negative coordinates.
# Scales 1.25 (150/120) and 0.8 (96/120) are exactly representable in
# wp_fractional_scale_v1 120ths — no shimmer (see the desktop file's DP-3 note).
# bitdepth,10 has no scenefx equivalent — see the desktop file's notes.

# Portrait side panel, far left (1080x1920 once rotated, scaled 0.8)
monitorrule=name:^DP-1$,width:1920,height:1080,refresh:60.0,x:0,y:0,scale:0.8,rr:1,vrr:0,hdr:0

# Center 4K
monitorrule=name:^DP-4$,width:3840,height:2160,refresh:60.0,x:1350,y:310,scale:1.25,rr:0,vrr:0,hdr:0

# Right 4K
monitorrule=name:^DP-3$,width:3840,height:2160,refresh:60.0,x:4422,y:310,scale:1.25,rr:0,vrr:0,hdr:0
