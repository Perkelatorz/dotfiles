# Hyprland-specific packages. Selected via:
#   yadm config local.compositor hyprland|mango|both   (default: both)
#
# The shared desktop stack this builds on (sddm, audio, quickshell, fonts,
# hypridle/hyprlock, ...) lives in wayland.pkgs and is always installed.

# --- Compositor ---
hyprland
# uwsm launches Hyprland as a systemd user unit (hyprland-uwsm.desktop). That is
# what makes environment.d/* reach the session — a plain Exec= session, like
# mango's, does not, which is why .config/zsh/.zprofile has to export the
# Bitwarden SSH agent vars itself.
uwsm

# --- Portal (screenshare/screenshot; speaks Hyprland-only protocols) ---
xdg-desktop-portal-hyprland

# --- hyprpm plugin build deps (base-devel covers gcc/make) ---
# Only needed for split-monitor-workspaces, which gives Hyprland the per-monitor
# workspaces that mango already has natively as tags.
meson
ninja
cmake
