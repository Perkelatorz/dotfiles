# mango (MangoWC) — the compositor. This is the only compositor in the setup;
# Hyprland was retired (see git log "Retire Hyprland; mango is the only
# compositor"), so there is no compositor selection any more and this list is
# always installed.
#
# mango's tag count (9) is compiled in via src/config/preset.h, so it is not
# configurable — the bar filters the strip down to 5 instead
# (quickshell/WorkspacePill.qml, visibleTagCount).

# --- Compositor ---
# NOT in the official Arch repos. Sources, in order of preference:
#   [cachyos] repo  — binary, works on CachyOS and on plain Arch once the repo
#                     is added (bootstrap offers this; see README.md).
#   AUR: mangowm    — same package, built locally.
# The AUR also has mangowm-wlonly-git, which swaps scenefx for the vulkan
# renderer and is the only build with working HDR.
mangowm

# --- Portal (screenshare/screenshot) ---
# xdg-desktop-portal-hyprland will not bind under mango; -wlr uses
# wlr-screencopy, which mango implements. Backend selection is in
# ~/.config/xdg-desktop-portal/mango-portals.conf.
#
# Caveat: -wlr does NOT implement the GlobalShortcuts interface, so apps that
# register hotkeys through the portal (Discord push-to-talk, OBS) lose them
# under mango. mango's own `globalkeybinding` window rule covers Wayland apps.
xdg-desktop-portal-wlr
