#!/bin/bash
set -euo pipefail

# yadm bootstrap — bare Arch-family install (NO desktop) → Wayland workstation.
#
# Supported distros:
#   CachyOS     — the reference target. Ships the [cachyos] repo already.
#   Arch Linux  — fully supported. Bootstrap offers to add the [cachyos] repo
#                 (see "The [cachyos] repo" below); without it the handful of
#                 non-Arch packages are built from the AUR instead.
#   Other Arch derivatives generally work, but are not tested.
#
# Fresh machine:
#   sudo pacman -S --needed git yadm
#   yadm clone https://github.com/perkelatorz/dotfiles
#   yadm config local.class desktop|laptop|work     # (bootstrap prompts if unset)
#   yadm bootstrap
#   reboot                                          # lands in SDDM → Mango
#
# The [cachyos] repo:
#   Eight packages in this setup are not in the Arch repos — mangowm (the
#   compositor itself), vesktop, sunshine, the nvidia-580xx branch, and the
#   CachyOS gaming stack. All of them are in [cachyos], a single ordinary
#   pacman repo (Include = /etc/pacman.d/cachyos-mirrorlist, ~840 packages).
#
#   On plain Arch, bootstrap offers to add it. It is appended BELOW core/extra,
#   so Arch keeps priority for every package both carry — this is deliberately
#   NOT what upstream's cachyos-repo.sh does. That script also layers
#   cachyos-core-znver4 / cachyos-extra-znver4 ABOVE core/extra and swaps in a
#   patched pacman, which replaces the base system with CachyOS rebuilds. We
#   want the extra packages, not the base-system takeover.
#
#   Decline it and bootstrap falls back to the AUR for everything except
#   cachyos-gaming-applications, which exists in neither Arch nor the AUR; the
#   gaming list is skipped with a printed list of Arch-native equivalents.
#
# Compositor: mango (MangoWC) only. Hyprland was retired — there is no
#   local.compositor setting any more, and packages/hyprland.pkgs is gone.
#
# Kernel-coupled packages (headers, NVIDIA modules) are NOT hardcoded in the
# lists. resolve_kernel_packages() reads the pkgbase of every installed kernel
# and derives them, because the correct package differs per kernel:
#   linux-cachyos  → linux-cachyos-headers  + linux-cachyos-nvidia-open
#   linux          → linux-headers          + nvidia-open-dkms
# Hardcoding nvidia-open-dkms was an outright conflict on CachyOS: it Conflicts
# With NVIDIA-MODULE, which every prebuilt linux-*-nvidia-open Provides.
#
# Classes (drive package lists in packages/class/ and ##class config alternates):
#   desktop  — home desktop: NVIDIA open modules, Sunshine game-stream host
#   laptop   — hybrid AMD iGPU + NVIDIA dGPU (prime-run offload)
#   work     — Pascal Quadros (legacy 580xx driver), xrdp for RDP access
#
# Gaming (opt-in; orthogonal to class — you can game on desktop or laptop):
#   yadm config local.gaming true      Persist the choice; bootstrap then always
#                                       installs the CachyOS gaming stack
#                                       (Steam/Proton/gamescope/MangoHud, see
#                                       packages/gaming.pkgs) + mango gaming
#                                       tweaks (mango/gaming.conf).
#   (bootstrap prompts once on desktop/laptop if local.gaming is unset)
#
# Env flags:
#   BOOTSTRAP_SKIP_UPGRADE=1   Skip full system upgrade (pacman -Syu). Not
#                              recommended on fresh installs — installing on a
#                              synced-but-not-upgraded system is a partial upgrade.
#   BOOTSTRAP_GAMING=1         Force-enable the gaming stack non-interactively
#                              (overrides local.gaming and the prompt).
#   BOOTSTRAP_CACHYOS_REPO=1|0 Add / skip the [cachyos] repo non-interactively.
#   CLAUDE_CODE_SKIP=1         Skip Claude Code CLI install.
# Idempotent: every step is safe to re-run; --needed skips installed packages.

PKG_DIR="$HOME/.config/yadm/packages"
SECRETS_FILE="$HOME/.config/nvim/secrets.lua"
MATUGEN_THEMES_DIR="$HOME/.config/matugen-themes"
# Notes vault. $NOTES is exported by .config/zsh/.zprofile, but bootstrap is bash
# and may run before that shell ever loads, hence the fallback.
VAULT="${NOTES:-$HOME/notes}"
SYNCTHING_FOLDER_ID="notes"

CLASS=""
HOST=""                   # short hostname; selects packages/host/<HOST>.pkgs
GAMING=false
DISTRO=""                 # cachyos | arch | arch-like | other
HAVE_CACHYOS_REPO=false   # is the [cachyos] repo configured?
KERNEL_PKGS=()            # headers + NVIDIA modules, derived per installed kernel
FAILED_PKGS=()

info() { echo "🔷 $*"; }
ok()   { echo "   ✓ $*"; }
warn() { echo "   ⚠️  $*"; }

read_pkg_file() {
    # Emit non-empty, non-comment lines from a package list.
    #
    # Trailing comments are stripped too, not just whole-line ones: a list entry
    # written as `nwg-displays   # GUI display editor` was otherwise handed to
    # pacman comment and all, which fails the bulk transaction, then fails again
    # in the one-at-a-time retry, and lands in FAILED_PKGS. That silently cost
    # nwg-displays on every run.
    sed -E 's/[[:space:]]*#.*$//; s/[[:space:]]+$//' "$1" 2>/dev/null \
        | grep -Ev '^[[:space:]]*$' || true
}

# --- class ---

ensure_class() {
    CLASS=$(yadm config local.class 2>/dev/null || true)
    if [[ -z "$CLASS" ]]; then
        local -a classes
        mapfile -t classes < <(basename -s .pkgs "$PKG_DIR"/class/*.pkgs)
        if [[ ! -t 0 ]]; then
            echo "❌ No machine class set and no TTY to ask."
            echo "   Run: yadm config local.class <$(IFS='|'; echo "${classes[*]}")> && yadm bootstrap"
            exit 1
        fi
        echo "This machine has no class yet. Available: ${classes[*]}"
        read -rp "Class for this machine: " CLASS
        if [[ ! -f "$PKG_DIR/class/$CLASS.pkgs" ]]; then
            echo "❌ No package list for class '$CLASS' ($PKG_DIR/class/$CLASS.pkgs)"
            exit 1
        fi
        yadm config local.class "$CLASS"
    fi
    ok "machine class: $CLASS"
    # Short hostname, the second selector. Class is the ROLE (every laptop
    # wants power-profiles-daemon); host is the MACHINE (this laptop's GPU).
    # Two laptops with different GPUs share class/laptop.pkgs and diverge in
    # host/<name>.pkgs, instead of forking the class and duplicating the rest.
    HOST=$(hostname -s 2>/dev/null || uname -n | cut -d. -f1)
    if [[ -f "$PKG_DIR/host/$HOST.pkgs" || -f "$PKG_DIR/host/$HOST.aur" ]]; then
        ok "machine host: $HOST"
    else
        ok "machine host: $HOST (no host list; add one with: pkgs add -l host/$HOST.pkgs <pkg>)"
    fi
    # Copy alternates instead of symlinking: yadm's auto-alt (runs on most yadm
    # commands) recreates symlinks, and the delete+create gap breaks a
    # compositor's inotify watch on sourced config files. A copy is overwritten
    # in place — same inode, so the watch survives.
    yadm config yadm.alt-copy true
    # Wire the tracked ignore file (yadm clone doesn't set this).
    yadm gitconfig core.excludesFile "~/.config/yadm/gitignore"
    # Materialize ##class./##hostname. alternates (e.g. mango/monitors.conf)
    # now that the class is known. (hooks/post_alt reloads the compositor if
    # one is live, so the new files take effect without a logout.)
    yadm alt >/dev/null 2>&1 && ok "yadm alternates refreshed" || warn "yadm alt failed"
}

# --- gaming (opt-in) ---

# Decide whether to install the gaming stack. Precedence:
#   BOOTSTRAP_GAMING env  >  stored local.gaming  >  interactive prompt  >  off.
# Orthogonal to class: gaming makes sense on desktop/laptop, not the work box, so
# work defaults off and is never prompted (override with: yadm config local.gaming true).
resolve_gaming() {
    if [[ -n "${BOOTSTRAP_GAMING:-}" ]]; then
        [[ "$BOOTSTRAP_GAMING" == "1" ]] && GAMING=true || GAMING=false
    else
        GAMING=$(yadm config --bool local.gaming 2>/dev/null || true)
        if [[ -z "$GAMING" ]]; then
            if [[ "$CLASS" == "work" ]]; then
                GAMING=false
            elif [[ -t 0 ]]; then
                read -rp "Install gaming stack (Steam/Proton/gamescope/MangoHud + HDR/tearing tweaks)? (y/N): " ans
                [[ "${ans,,}" == y* ]] && GAMING=true || GAMING=false
                yadm config local.gaming "$GAMING"
            else
                GAMING=false
            fi
        fi
    fi
    [[ "$GAMING" == "true" ]] && ok "gaming stack: enabled" || ok "gaming stack: disabled"
}

# --- distro + repos ---

# Which Arch-family distro this is. Only two behaviours actually differ:
# whether [cachyos] is already configured, and whether [multilib] is on.
detect_distro() {
    DISTRO=other
    if [[ -r /etc/os-release ]]; then
        # shellcheck disable=SC1091
        local id id_like
        id=$(. /etc/os-release && echo "${ID:-}")
        id_like=$(. /etc/os-release && echo "${ID_LIKE:-}")
        case "$id" in
            cachyos) DISTRO=cachyos ;;
            arch)    DISTRO=arch ;;
            *) [[ "$id_like" == *arch* ]] && DISTRO=arch-like ;;
        esac
    fi
    have_cachyos_repo && HAVE_CACHYOS_REPO=true || HAVE_CACHYOS_REPO=false
    ok "distro: $DISTRO ([cachyos] repo: $HAVE_CACHYOS_REPO)"
}

# An enabled (not merely commented-out) [cachyos] section in pacman.conf.
have_cachyos_repo() {
    grep -qE '^[[:space:]]*\[cachyos\][[:space:]]*$' /etc/pacman.conf
}

# Add the plain [cachyos] repo — NOT the znver4/v4/v3 optimized rebuilds.
#
# Upstream's cachyos-repo.sh inserts cachyos-core-znver4 / cachyos-extra-znver4
# ABOVE core/extra and installs a patched pacman, so the base system starts
# coming from CachyOS rebuilds. That is a much larger commitment than "I want
# mangowm as a binary". [cachyos] is an ordinary independent repo behind its own
# mirrorlist, so we append just that, BELOW the Arch repos: pacman resolves
# top-down, so anything Arch also ships keeps coming from Arch.
#
# Package filenames are discovered from the mirror index rather than pinned,
# because the pinned versions in upstream's script go stale.
ensure_cachyos_repo() {
    have_cachyos_repo && { HAVE_CACHYOS_REPO=true; return 0; }

    case "${BOOTSTRAP_CACHYOS_REPO:-}" in
        0) ok "[cachyos] repo declined (BOOTSTRAP_CACHYOS_REPO=0)"; return 1 ;;
        1) ;;
        *)
            if [[ ! -t 0 ]]; then
                warn "no TTY to ask about the [cachyos] repo; falling back to the AUR"
                return 1
            fi
            cat <<'EOF'

   The [cachyos] repo carries the packages Arch does not have: mangowm (the
   compositor), vesktop, sunshine, nvidia-580xx, and the gaming stack.
   Adding it means those install as signed binaries instead of AUR builds.

   This adds ONE repo, appended BELOW core/extra so Arch keeps priority.
   It does NOT add the znver4 optimized rebuilds and does NOT replace pacman.
   Undo later with: sudo sed -i '/^\[cachyos\]$/,+1d' /etc/pacman.conf

EOF
            local ans
            read -rp "Add the [cachyos] repo? (Y/n): " ans
            [[ "${ans,,}" == n* ]] && { ok "declined — using the AUR instead"; return 1; }
            ;;
    esac

    info "Adding the [cachyos] repo..."
    local mirror="https://mirror.cachyos.org/repo/x86_64/cachyos"
    local keyid="F3B607488DB35A47"

    sudo pacman-key --recv-keys "$keyid" --keyserver keyserver.ubuntu.com \
        || { warn "could not fetch the CachyOS signing key; falling back to the AUR"; return 1; }
    sudo pacman-key --lsign-key "$keyid" \
        || { warn "could not locally sign the CachyOS key"; return 1; }

    # Discover current filenames from the mirror index instead of pinning them.
    local index keyring_pkg mirrorlist_pkg
    index=$(curl -sfL "$mirror/") || { warn "mirror index unreachable"; return 1; }
    keyring_pkg=$(grep -oE 'cachyos-keyring-[0-9][^"<]*\.pkg\.tar\.zst' <<<"$index" | sort -V | tail -1)
    mirrorlist_pkg=$(grep -oE 'cachyos-mirrorlist-[0-9][^"<]*\.pkg\.tar\.zst' <<<"$index" | sort -V | tail -1)
    [[ -n "$keyring_pkg" && -n "$mirrorlist_pkg" ]] \
        || { warn "could not find keyring/mirrorlist on the mirror"; return 1; }

    sudo pacman -U --needed --noconfirm "$mirror/$keyring_pkg" "$mirror/$mirrorlist_pkg" \
        || { warn "installing cachyos-keyring/mirrorlist failed"; return 1; }

    # Append below every existing repo section.
    printf '\n[cachyos]\nInclude = /etc/pacman.d/cachyos-mirrorlist\n' \
        | sudo tee -a /etc/pacman.conf >/dev/null
    sudo pacman -Sy --noconfirm || { warn "pacman -Sy failed after adding [cachyos]"; return 1; }

    HAVE_CACHYOS_REPO=true
    ok "[cachyos] repo added (below core/extra)"
}

# The gaming stack and the 32-bit GPU drivers need [multilib]. CachyOS enables it
# out of the box; a stock Arch install leaves it commented out.
ensure_multilib() {
    grep -qE '^[[:space:]]*\[multilib\][[:space:]]*$' /etc/pacman.conf && return 0
    grep -qE '^[[:space:]]*#[[:space:]]*\[multilib\][[:space:]]*$' /etc/pacman.conf || {
        warn "no [multilib] section in pacman.conf; 32-bit packages will fail"
        return 1
    }
    info "Enabling [multilib] (32-bit packages need it)..."
    # Uncomment the [multilib] header and the Include line that follows it.
    sudo sed -i '/^[[:space:]]*#[[:space:]]*\[multilib\][[:space:]]*$/,+1 s/^[[:space:]]*#[[:space:]]*//' \
        /etc/pacman.conf
    sudo pacman -Sy --noconfirm >/dev/null 2>&1 || true
    grep -qE '^[[:space:]]*\[multilib\][[:space:]]*$' /etc/pacman.conf \
        && ok "[multilib] enabled" || warn "could not enable [multilib]"
}

# Is this package name resolvable by pacman (i.e. in some configured repo)?
in_repos() { pacman -Si "$1" &>/dev/null; }

# --- kernel-coupled packages ---

# Headers and NVIDIA modules depend on WHICH kernel is installed, so they are
# derived here instead of being hardcoded in the class lists.
#
# Every Arch kernel package drops /usr/lib/modules/<ver>/pkgbase naming the
# package that owns it, which is the authoritative way to enumerate installed
# kernels. For each one:
#   <pkgbase>-headers        always (DKMS and out-of-tree modules need them)
#   <pkgbase>-nvidia-open    if the repos have a prebuilt module for that kernel
#                            (CachyOS ships these for every kernel flavour)
#   nvidia-open-dkms         otherwise, once, as the portable fallback
#
# The prebuilt and DKMS variants BOTH satisfy NVIDIA-MODULE and conflict with
# each other, so exactly one provider is emitted.
resolve_kernel_packages() {
    KERNEL_PKGS=()
    local -a kernels=()
    local d base
    for d in /usr/lib/modules/*/; do
        [[ -r "$d/pkgbase" ]] || continue
        base=$(<"$d/pkgbase")
        [[ -n "$base" ]] && kernels+=("$base")
    done
    if (( ! ${#kernels[@]} )); then
        warn "no kernel pkgbase found under /usr/lib/modules; skipping headers"
        return 0
    fi
    mapfile -t kernels < <(printf '%s\n' "${kernels[@]}" | sort -u)

    # Ask the hardware, not the class. Deciding by class breaks as soon as two
    # machines share a role but not a GPU -- two laptops, one NVIDIA/AMD hybrid
    # and one Intel-only, are both class=laptop.
    local want_nvidia=false
    if lspci -n 2>/dev/null | awk '{print $3}' | grep -qi '^10de:'; then
        want_nvidia=true
        ok "NVIDIA GPU detected"
    elif ! command -v lspci &>/dev/null; then
        # pciutils missing (it is in base.pkgs, but this can run before that
        # lands on a truly bare system): fall back to the old class guess
        # rather than silently skipping the driver on a machine that needs it.
        case "$CLASS" in desktop|laptop|work) want_nvidia=true ;; esac
        warn "lspci unavailable; assuming NVIDIA from class=$CLASS"
    else
        ok "no NVIDIA GPU detected; skipping NVIDIA kernel modules"
    fi

    local need_dkms=false
    for base in "${kernels[@]}"; do
        in_repos "$base-headers" && KERNEL_PKGS+=("$base-headers") \
            || warn "$base-headers not in any repo"
        if [[ "$want_nvidia" == true ]]; then
            if in_repos "$base-nvidia-open"; then
                KERNEL_PKGS+=("$base-nvidia-open")
            else
                need_dkms=true
            fi
        fi
    done
    # One DKMS fallback covers every kernel that had no prebuilt module.
    if [[ "$need_dkms" == true ]] && in_repos nvidia-open-dkms; then
        KERNEL_PKGS+=(nvidia-open-dkms)
    fi

    ok "kernels: ${kernels[*]}"
    (( ${#KERNEL_PKGS[@]} )) && ok "kernel packages: ${KERNEL_PKGS[*]}"
}


# --- package installation ---

# Bulk install with --needed; if the transaction fails (one bad package, a
# provider conflict, ...), fall back to one-at-a-time so the rest still lands.
# stdin </dev/null auto-picks the default provider on "N providers available"
# prompts that --noconfirm alone won't answer.
install_repo_pkgs() {
    local -a pkgs=("$@")
    (( ${#pkgs[@]} )) || return 0
    info "Installing ${#pkgs[@]} repo package(s)..."
    if sudo pacman -S --needed --noconfirm "${pkgs[@]}" </dev/null; then
        return 0
    fi
    warn "bulk install failed; retrying one at a time"
    for p in "${pkgs[@]}"; do
        sudo pacman -S --needed --noconfirm "$p" </dev/null \
            || { warn "pacman failed: $p"; FAILED_PKGS+=("$p"); }
    done
}

# Make sure an AUR helper exists.
#
# paru is a repo package on CachyOS and in [cachyos], so on those it is a normal
# pacman install. On plain Arch without that repo it is AUR-only, which is a
# chicken-and-egg: you need an AUR helper to install the AUR helper. Break it
# with a one-off makepkg from the git repo — the ONLY thing this setup ever
# builds by hand.
#
# The bar also shells out to paru (`paru -Qua` for the AUR update count, and the
# tools menu opens `kitty -e paru`), so it is wanted even when no AUR package is.
ensure_aur_helper() {
    command -v paru &>/dev/null && return 0
    if in_repos paru; then
        sudo pacman -S --needed --noconfirm paru && return 0
    fi
    info "Building paru from the AUR (one-time)..."
    sudo pacman -S --needed --noconfirm base-devel git || return 1
    local tmp
    tmp=$(mktemp -d) || return 1
    if git clone --depth 1 https://aur.archlinux.org/paru-bin.git "$tmp/paru-bin" &>/dev/null \
        && (cd "$tmp/paru-bin" && makepkg -si --noconfirm &>/dev/null); then
        rm -rf "$tmp"
        ok "paru installed"
        return 0
    fi
    rm -rf "$tmp"
    warn "could not install paru — AUR packages will be skipped"
    return 1
}

install_aur_pkgs() {
    local -a pkgs=("$@")
    (( ${#pkgs[@]} )) || return 0
    ensure_aur_helper || { FAILED_PKGS+=("${pkgs[@]}"); return 0; }
    info "Installing ${#pkgs[@]} AUR package(s)..."
    # --skipreview: paru's PKGBUILD review prompt stalls scripted runs.
    for p in "${pkgs[@]}"; do
        paru -S --needed --noconfirm --skipreview --sudoloop "$p" \
            || { warn "paru failed: $p"; FAILED_PKGS+=("$p"); }
    done
}

install_packages() {
    local -a repo_pkgs=() aur_pkgs=()
    local f
    for f in "$PKG_DIR"/*.pkgs "$PKG_DIR/class/$CLASS.pkgs" "$PKG_DIR/host/$HOST.pkgs"; do
        [[ -f "$f" ]] || continue
        # gaming.pkgs is selection-gated and added explicitly below, never via
        # the glob. (mango.pkgs used to be gated too, back when Hyprland was an
        # alternative; it is now unconditional and rides the glob.)
        [[ "$(basename "$f")" == "gaming.pkgs" ]] && continue
        mapfile -t -O "${#repo_pkgs[@]}" repo_pkgs < <(read_pkg_file "$f")
        # Relative path, not basename: class/ and host/ lists can share a name
        # (class/laptop.pkgs vs host/laptop.pkgs) and the log should say which.
        ok "list: ${f#$PKG_DIR/}"
    done

    # Headers / NVIDIA modules for the kernels actually installed.
    if (( ${#KERNEL_PKGS[@]} )); then
        repo_pkgs+=("${KERNEL_PKGS[@]}")
        ok "list: kernel-derived (${#KERNEL_PKGS[@]})"
    fi

    local af
    for af in "$PKG_DIR/class/$CLASS.aur" "$PKG_DIR/host/$HOST.aur"; do
        [[ -f "$af" ]] || continue
        mapfile -t -O "${#aur_pkgs[@]}" aur_pkgs < <(read_pkg_file "$af")
        ok "list: ${af#$PKG_DIR/} (AUR)"
    done

    if [[ "$GAMING" == "true" ]]; then
        # cachyos-gaming-applications is in [cachyos] and NOWHERE else — not in
        # Arch, not in the AUR. Without the repo there is nothing to fall back
        # to, so skip the list and say what to install by hand instead of
        # letting pacman fail on a package that cannot exist.
        if [[ "$HAVE_CACHYOS_REPO" == true ]]; then
            if [[ -f "$PKG_DIR/gaming.pkgs" ]]; then
                mapfile -t -O "${#repo_pkgs[@]}" repo_pkgs < <(read_pkg_file "$PKG_DIR/gaming.pkgs")
                ok "list: gaming.pkgs (gaming)"
            fi
            if [[ -f "$PKG_DIR/gaming.aur" ]]; then
                mapfile -t -O "${#aur_pkgs[@]}" aur_pkgs < <(read_pkg_file "$PKG_DIR/gaming.aur")
                (( ${#aur_pkgs[@]} )) && ok "list: gaming.aur (AUR)"
            fi
        else
            warn "gaming enabled but no [cachyos] repo — skipping gaming.pkgs"
            echo "      cachyos-gaming-applications exists only in [cachyos]."
            echo "      Arch-native equivalent:"
            echo "        sudo pacman -S steam lutris gamescope goverlay mangohud \\"
            echo "                       lib32-mangohud wine winetricks vulkan-tools"
            echo "        paru -S heroic-games-launcher protontricks umu-launcher"
        fi
    fi

    # Drop anything no configured repo can resolve, so one unavailable package
    # cannot fail the bulk transaction and drag the rest into the slow
    # one-at-a-time retry path.
    local -a resolvable=() unresolvable=()
    local pkg
    mapfile -t repo_pkgs < <(printf '%s\n' "${repo_pkgs[@]}" | awk 'NF && !seen[$0]++')
    for pkg in "${repo_pkgs[@]}"; do
        if in_repos "$pkg" || pacman -Sg "$pkg" &>/dev/null; then
            resolvable+=("$pkg")
        else
            unresolvable+=("$pkg")
        fi
    done
    if (( ${#unresolvable[@]} )); then
        warn "${#unresolvable[@]} package(s) in no configured repo: ${unresolvable[*]}"
        if [[ "$HAVE_CACHYOS_REPO" != true ]]; then
            echo "      Trying the AUR for these instead."
            aur_pkgs+=("${unresolvable[@]}")
        else
            FAILED_PKGS+=("${unresolvable[@]}")
        fi
    fi

    install_repo_pkgs "${resolvable[@]}"
    install_aur_pkgs "${aur_pkgs[@]}"
    # The bar shells out to paru even when nothing came from the AUR.
    ensure_aur_helper || true
}

# Mark everything the lists declare as explicitly installed.
#
# `pacman -S --needed` skips a package that is already present, and skipping it
# leaves its install reason alone. So anything the ISO pulled in as a
# dependency stays marked "dependency" forever, even though these lists now
# declare it deliberately.
#
# That is not cosmetic. `pacman -Rs` removes dependencies that nothing else
# needs, and on this machine that cascade would have taken mangowm -- the
# compositor -- along with zsh, pipewire and curl, because they arrived as
# dependencies of the ISO's desktop profile and were never re-marked. Declaring
# a package and having pacman believe nothing wants it is the bug.
#
# Only lists that apply to THIS machine are marked; class/work.pkgs naming
# xorg-server should not make it explicit on a laptop where it is genuinely
# just somebody's dependency.
converge_install_reasons() {
    local -a declared=() fix=()
    local f p
    for f in "$PKG_DIR"/*.pkgs "$PKG_DIR"/*.aur \
             "$PKG_DIR/class/$CLASS.pkgs" "$PKG_DIR/class/$CLASS.aur" \
             "$PKG_DIR/host/$HOST.pkgs" "$PKG_DIR/host/$HOST.aur"; do
        [[ -f "$f" ]] || continue
        mapfile -t -O "${#declared[@]}" declared < <(read_pkg_file "$f")
    done
    (( ${#declared[@]} )) || return 0

    # Intersect with what pacman currently calls a dependency.
    local -A isdep=()
    while read -r p; do isdep["$p"]=1; done < <(pacman -Qqd 2>/dev/null)
    local -A seen=()
    for p in "${declared[@]}"; do
        [[ -n "${isdep[$p]:-}" && -z "${seen[$p]:-}" ]] || continue
        seen["$p"]=1
        fix+=("$p")
    done
    (( ${#fix[@]} )) || { ok "install reasons already correct"; return 0; }

    info "Marking ${#fix[@]} declared package(s) as explicitly installed..."
    if sudo pacman -D --asexplicit --noconfirm "${fix[@]}" &>/dev/null; then
        ok "install reasons converged: ${fix[*]}"
    else
        warn "could not update install reasons"
    fi
}

# --- services ---

enable_system_service() {
    local svc="$1" now="${2:-}"
    if ! systemctl list-unit-files "$svc.service" &>/dev/null; then
        warn "$svc.service not present; skipping"
        return
    fi
    local -a cmd=(sudo systemctl enable)
    [[ "$now" == "--now" ]] && cmd+=(--now)
    if "${cmd[@]}" "$svc" &>/dev/null; then
        ok "$svc enabled${now:+ + started}"
    else
        warn "failed: sudo systemctl enable $now $svc"
    fi
}

enable_user_service() {
    local svc="$1" now="${2:-}"
    local -a cmd=(systemctl --user enable)
    [[ "$now" == "--now" ]] && cmd+=(--now)
    if "${cmd[@]}" "$svc" &>/dev/null; then
        ok "$svc (user) enabled${now:+ + started}"
        return 0
    fi
    warn "$svc not enabled — run: systemctl --user enable $now $svc"
    return 1
}

setup_services() {
    info "Enabling services..."
    enable_system_service NetworkManager --now
    enable_system_service bluetooth --now
    enable_system_service tailscaled --now
    # power-profiles-daemon: laptops want profile switching, and CachyOS's
    # `game-performance` wrapper drives it over D-Bus to flip to `performance`
    # for the life of a game. It was found running-but-not-enabled on the
    # desktop, which works until the first reboot.
    if pacman -Qq power-profiles-daemon &>/dev/null; then
        enable_system_service power-profiles-daemon --now
    fi

    # gamemode and ananicy-cpp both rewrite process niceness and conflict; the
    # CachyOS gaming guide says to pick one. ananicy-cpp is a dependency of
    # cachyos-settings so it cannot be removed, only stopped. We only warn --
    # silently disabling a service the distro enabled is not bootstrap's call.
    if [[ "$GAMING" == "true" ]] \
        && pacman -Qq gamemode &>/dev/null \
        && systemctl is-active ananicy-cpp &>/dev/null; then
        warn "ananicy-cpp is active alongside gamemode — they fight over niceness"
        echo "      The CachyOS gaming guide recommends one or the other:"
        echo "        sudo systemctl disable --now ananicy-cpp"
    fi
    # sddm: enable only — starting it now would tear down this TTY mid-bootstrap.
    enable_system_service sddm

    # Syncthing replicates ~/notes between machines over the tailnet. Runs as a
    # user unit (it touches $HOME, so it must not be a system service). Enabled
    # here, started later by setup_syncthing_vault -- which needs the daemon up to
    # configure the folder through its API, and runs after the tailscale step
    # below so the two do not race.
    if command -v syncthing &>/dev/null; then
        enable_user_service syncthing.service
        # Without lingering, syncthing dies at logout and stops replicating on a
        # box you only ever reach over ssh/RDP.
        if ! loginctl show-user "$USER" -p Linger --value 2>/dev/null | grep -q yes; then
            if sudo loginctl enable-linger "$USER" &>/dev/null; then
                ok "lingering enabled for $USER (syncthing survives logout)"
            else
                warn "could not enable lingering — run: sudo loginctl enable-linger $USER"
            fi
        fi
    fi

    case "$CLASS" in
        desktop)
            # Sunshine's user unit keeps its upstream flatpak-style name. Needs a
            # session bus (fails harmlessly over bare ssh — re-run after first
            # graphical login).
            local sunshine_unit="app-dev.lizardbyte.app.Sunshine.service"
            if systemctl --user enable "$sunshine_unit" &>/dev/null; then
                ok "sunshine user service enabled (pair via https://localhost:47990)"
            else
                warn "sunshine not enabled — run: systemctl --user enable --now $sunshine_unit"
            fi
            ;;
        work)
            enable_system_service xrdp --now
            enable_system_service xrdp-sesman --now
            ;;
        *)
            # Converge: only work machines serve RDP. Disable leftovers from a
            # previous life (packages can be removed with: pacman -Rns xrdp xorgxrdp).
            if systemctl is-enabled xrdp &>/dev/null; then
                warn "xrdp enabled but class=$CLASS — disabling"
                sudo systemctl disable --now xrdp xrdp-sesman &>/dev/null || true
                rm -f "$HOME/startwm.sh"
            fi
            ;;
    esac

    if command -v tailscale &>/dev/null && ! tailscale status &>/dev/null; then
        echo "   ℹ️  Tailscale not authed yet — run: sudo tailscale up"
    fi
}

# --- one-time machine setup ---

setup_syncthing_vault() {
    command -v syncthing &>/dev/null || return 0

    info "Syncthing notes vault..."
    mkdir -p "$VAULT"

    # The folder is configured through the running daemon's API rather than by
    # editing config.xml, because syncthing rewrites that file from memory and
    # would clobber an offline edit. `syncthing cli` finds the address and API
    # key from the config dir itself, so nothing has to be parsed out by hand.
    if ! systemctl --user is-active --quiet syncthing.service; then
        systemctl --user start syncthing.service 2>/dev/null || true
    fi

    local i
    for i in {1..30}; do
        syncthing cli config folders list &>/dev/null && break
        sleep 1
    done
    if ! syncthing cli config folders list &>/dev/null; then
        warn "syncthing API not responding — vault folder not configured"
        echo "      start it and re-run bootstrap: systemctl --user start syncthing.service"
        return 0
    fi

    # Idempotent: an existing folder is left exactly as it is, so a re-run never
    # disturbs sharing or ignore settings established on this machine.
    if syncthing cli config folders list 2>/dev/null | grep -qx "$SYNCTHING_FOLDER_ID"; then
        ok "vault folder '$SYNCTHING_FOLDER_ID' already configured"
    else
        # The ID must match on every machine -- it, not the path or label, is what
        # pairs two folders. Left to syncthing it would be a random 5-char string,
        # different on each host and impossible to line up by hand.
        if syncthing cli config folders add \
            --id "$SYNCTHING_FOLDER_ID" --label "Notes" \
            --path "$VAULT" --type sendreceive &>/dev/null; then
            ok "vault folder '$SYNCTHING_FOLDER_ID' → $VAULT"
        else
            warn "could not add the vault folder — add it in the GUI (http://127.0.0.1:8384)"
            return 0
        fi
        # Keep 10 old copies under .stversions. Sync has no undo of its own: a
        # delete or a bad overwrite propagates to every peer within seconds.
        # .stversions is excluded by both .gitignore and .stignore in the vault.
        syncthing cli config folders "$SYNCTHING_FOLDER_ID" versioning type set simple &>/dev/null \
            && syncthing cli config folders "$SYNCTHING_FOLDER_ID" versioning params set keep 10 &>/dev/null \
            && ok "file versioning: keep 10 (.stversions/)" \
            || warn "versioning not set — enable it in the GUI"
    fi

    setup_syncthing_tailnet

    # Pairing needs a device ID from the *other* machine, so it cannot be
    # scripted from one side. Print what the other end needs.
    local myid
    myid=$(syncthing cli show system 2>/dev/null | sed -n 's/.*"myID"[[:space:]]*:[[:space:]]*"\([^"]*\)".*/\1/p') || true
    if [[ -n "$myid" ]]; then
        echo "      this device: $myid"
        echo "      pair: add that ID on the other machine, share folder '$SYNCTHING_FOLDER_ID',"
        echo "            then accept the invite here (http://127.0.0.1:8384)"
        # With discovery off there is nothing left to resolve a peer, so the
        # default "dynamic" address never connects. Every device entry has to
        # carry an explicit tailnet address on both ends.
        echo "      IMPORTANT: set each device's address to tcp://<its-tailscale-ip>:22000,"
        echo "                 not 'dynamic' -- discovery is disabled (tailnet-only)"
    fi

    # .stignore ships with the vault, so on a fresh machine it only exists after
    # the first sync completes. Harmless: a brand-new vault has no .git to leak.
    [[ -f "$VAULT/.stignore" ]] || echo "      note: .stignore arrives with the first sync"
}

# Confine syncthing to the tailnet: bind the sync listener to the tailscale
# address only, and switch off every mechanism that would reach a peer any other
# way -- public discovery servers, relays, UPnP, and LAN broadcast.
#
# Traffic was already TLS without this; what it buys is *path* control. By
# default syncthing announces to public discovery servers and will happily route
# a connection over the open internet or a third-party relay. After this the only
# route to a peer is the tailnet, and the daemon is not reachable from the LAN at
# all.
#
# The trade is that nothing discovers peers any more, so each device needs an
# explicit tcp://100.x.x.x:22000 address at both ends.
setup_syncthing_tailnet() {
    command -v tailscale &>/dev/null || return 0

    local tsip
    tsip=$(tailscale ip -4 2>/dev/null | head -1) || true
    if [[ -z "$tsip" ]]; then
        # Deliberately do nothing. Binding to an address that does not exist yet
        # would leave syncthing with no listener at all -- worse than the default.
        warn "tailscale not up — syncthing left on default (public) discovery"
        echo "      re-run bootstrap after: sudo tailscale up"
        return 0
    fi

    local conf="" d
    for d in "${XDG_STATE_HOME:-$HOME/.local/state}/syncthing" "$HOME/.config/syncthing"; do
        [[ -f "$d/config.xml" ]] && { conf="$d/config.xml"; break; }
    done
    [[ -n "$conf" ]] || { warn "syncthing config.xml not found — tailnet lockdown skipped"; return 0; }

    # Already bound to this address? Then leave the daemon alone; re-PATCHing
    # restarts the listeners for no reason.
    if grep -q "<listenAddress>tcp://$tsip:22000</listenAddress>" "$conf"; then
        ok "tailnet-only (listening on $tsip:22000)"
        return 0
    fi

    # The listen-address list is not settable through `syncthing cli` (it exposes
    # only list/add on that collection), so this one goes through the REST API,
    # which replaces the whole options object atomically.
    local key
    key=$(sed -n 's:.*<apikey>\(.*\)</apikey>.*:\1:p' "$conf" | head -1)
    [[ -n "$key" ]] || { warn "could not read syncthing API key — tailnet lockdown skipped"; return 0; }

    if curl -sf -X PATCH -H "X-API-Key: $key" -H 'Content-Type: application/json' \
        --data "{\"listenAddresses\":[\"tcp://$tsip:22000\",\"quic://$tsip:22000\"],\"globalAnnounceEnabled\":false,\"localAnnounceEnabled\":false,\"relaysEnabled\":false,\"natEnabled\":false,\"announceLANAddresses\":false}" \
        http://127.0.0.1:8384/rest/config/options &>/dev/null; then
        ok "tailnet-only: listening on $tsip:22000, discovery/relays/UPnP off"
    else
        warn "tailnet lockdown failed — syncthing still on public discovery"
    fi
}

setup_default_shell_zsh() {
    local zsh_path current
    zsh_path=$(command -v zsh) || { warn "zsh missing"; return; }
    current=$(getent passwd "$USER" | cut -d: -f7)
    [[ "$current" == "$zsh_path" || "$current" == "/bin/zsh" ]] && return
    info "Default shell → zsh..."
    chsh -s "$zsh_path" && ok "shell set (takes effect next login)" || warn "chsh failed"
}

setup_neovim_secrets() {
    [[ -f "$SECRETS_FILE" ]] && return
    info "Neovim secrets stub..."
    mkdir -p "$(dirname "$SECRETS_FILE")"
    cat > "$SECRETS_FILE" <<'EOF'
return {
  ANTHROPIC_API_KEY = "your-anthropic-key-here",
  OPENAI_API_KEY = "your-openai-key-here",
}
EOF
    ok "created $SECRETS_FILE — add real keys"
}

# Real git identities are untracked (this repo is public). Seed them from the
# tracked .example templates so `git config` under ~/code/{work,personal} has
# something to include; git skips a missing includeIf path silently, so this is
# a convenience, not a requirement.
setup_git_identities() {
    local which src dst
    for which in work personal; do
        src="$HOME/.config/git/config-$which.example"
        dst="$HOME/.config/git/config-$which"
        [[ -f "$src" ]] || continue
        [[ -f "$dst" ]] && continue
        cp "$src" "$dst"
        ok "created ~/.config/git/config-$which — put your real $which identity in it"
    done
}

setup_matugen_themes() {
    [[ -d "$MATUGEN_THEMES_DIR/.git" ]] && return
    if [[ -d "$MATUGEN_THEMES_DIR" ]]; then
        warn "$MATUGEN_THEMES_DIR exists but is not a git repo; skipping"
        return
    fi
    info "Cloning matugen-themes (select-wallpaper.sh needs it)..."
    git clone --depth 1 https://github.com/InioX/matugen-themes.git "$MATUGEN_THEMES_DIR" \
        || warn "clone failed"
}

install_claude_code_cli() {
    [[ "${CLAUDE_CODE_SKIP:-}" == "1" ]] && return
    if command -v claude &>/dev/null || [[ -x "$HOME/.local/bin/claude" ]]; then
        return
    fi
    info "Installing Claude Code CLI..."
    curl -fsSL https://claude.ai/install.sh | bash \
        && ok "installed (ensure ~/.local/bin on PATH)" \
        || warn "install failed — retry: curl -fsSL https://claude.ai/install.sh | bash"
}

# Headless nvim run so vim.pack pulls plugins (Mason finishes later in :Mason).
warm_neovim_plugins() {
    command -v nvim &>/dev/null || return 0
    [[ -f "$HOME/.config/nvim/init.lua" ]] || return 0
    info "Warming Neovim plugins (headless)..."
    if nvim --headless -c 'qa' &>/dev/null; then
        ok "vim.pack done — open nvim and :Mason for LSP binaries"
    else
        warn "headless nvim exited non-zero (usually fine on first run)"
    fi
}

# --- work-only: RDP session (xrdp → XFCE) ---
# Uses xrdp's per-user hook: sesman.ini ships EnableUserWindowManager=true /
# UserWindowManager=startwm.sh, so ~/startwm.sh is exec'd directly when present
# — no /etc patching, and it takes precedence over the distro-sniffing
# /etc/xrdp/startwm.sh. Strips Wayland/compositor env so XFCE/dbus start clean;
# kills stale xfconfd left by a local mango session sharing $HOME.
setup_rdp_session() {
    info "RDP session (xrdp → XFCE)..."
    if ! command -v startxfce4 &>/dev/null; then
        warn "startxfce4 missing — xfce4 group failed to install?"
        return
    fi
    if [[ -f /etc/xrdp/sesman.ini ]] \
        && ! grep -q '^EnableUserWindowManager=true' /etc/xrdp/sesman.ini; then
        warn "sesman.ini has EnableUserWindowManager disabled — ~/startwm.sh will be ignored"
    fi

    local wm="$HOME/startwm.sh"
    local marker="# managed by yadm bootstrap (rdp-xfce)"
    if [[ -f "$wm" ]] && ! grep -qF "$marker" "$wm"; then
        cp "$wm" "$wm.bak.$(date +%s)"
        warn "backed up existing $wm"
    fi
    cat >"$wm" <<EOF
#!/bin/sh
$marker
# Executed by xrdp-sesman on RDP login (sesman.ini: UserWindowManager).

# Strip Wayland/compositor env leaked from the local session profile.
unset WAYLAND_DISPLAY MANGO_INSTANCE_SIGNATURE
export XDG_SESSION_TYPE=x11
export XDG_CURRENT_DESKTOP=XFCE

# Kill stale xfconfd from local session (same \$HOME = same xfconf cache).
killall xfconfd 2>/dev/null || true

exec dbus-run-session -- startxfce4
EOF
    chmod +x "$wm"
    ok "wrote $wm"
    cat <<'EOF'
   ℹ️  RDP notes:
      • Firewall: open 3389/tcp if one is active.
      • Windows: mstsc → <host>:3389 → Linux creds → session type "Xorg".
      • Log out of the local mango session before RDP-ing as the same user (or use a
        dedicated user) — shared $HOME means xfconfd/Thunar conflicts.
EOF
}

# --- main ---

echo "🚀 Arch/CachyOS → mango Wayland desktop bootstrap"
[[ -d "$PKG_DIR" ]] || { echo "❌ $PKG_DIR not found"; exit 1; }
command -v pacman &>/dev/null || { echo "❌ pacman not found — this is Arch-family only"; exit 1; }
sudo -v || { echo "❌ sudo required"; exit 1; }

ensure_class
detect_distro
resolve_gaming
# Repos before the upgrade: adding [cachyos] and [multilib] both resync the db,
# and packages from them must be visible to the single install transaction.
ensure_cachyos_repo || true
[[ "$GAMING" == "true" || "$CLASS" != "work" ]] && ensure_multilib || true

if [[ "${BOOTSTRAP_SKIP_UPGRADE:-}" == "1" ]]; then
    info "Syncing package databases (upgrade skipped)..."
    sudo pacman -Sy --noconfirm
else
    info "Full system upgrade (pacman -Syu)..."
    sudo pacman -Syu --noconfirm
fi

resolve_kernel_packages
install_packages
converge_install_reasons
setup_services
setup_syncthing_vault
setup_default_shell_zsh
setup_neovim_secrets
setup_git_identities
setup_matugen_themes
install_claude_code_cli
warm_neovim_plugins
[[ "$CLASS" == "work" ]] && setup_rdp_session

echo
echo "✨ Bootstrap complete (class: $CLASS, host: $HOST, distro: $DISTRO)"
if (( ${#FAILED_PKGS[@]} )); then
    echo "⚠️  ${#FAILED_PKGS[@]} package(s) failed:"
    printf '   ✗ %s\n' "${FAILED_PKGS[@]}"
    # NVIDIA failures on an already-installed machine = driver-branch conflict
    # (e.g. 580xx installed, list wants open). --noconfirm won't remove the old
    # branch; the swap needs an interactive run.
    mapfile -t nvidia_failed < <(printf '%s\n' "${FAILED_PKGS[@]}" | grep -E '^(lib32-)?nvidia' || true)
    if (( ${#nvidia_failed[@]} )); then
        echo "   ℹ️  NVIDIA branch swap needs interactive confirmation:"
        echo "      sudo pacman -S ${nvidia_failed[*]}"
        echo "      (answer y to remove the old driver branch, then reboot)"
    fi
fi
if [[ "$GAMING" == "true" ]]; then
    echo "🎮 Gaming stack installed. After reboot:"
    echo "   • Steam → Settings → Compatibility → enable Proton for all titles"
    echo "     (pick Proton-CachyOS in a game's Compatibility tab)."
    echo "   • Per-game launch options (Properties → Launch Options), e.g.:"
    echo "       gamemoderun mangohud %command%           # perf + FPS/temp HUD"
    echo "       gamescope -f --hdr-enabled -- %command%  # HDR / scaling"
    echo "   • MangoHud overlay toggles in-game with Right Shift + F12."
    echo "   • mango HDR needs the wl-only build (AUR: mangowm-wlonly-git) —"
    echo "     scenefx has no vulkan renderer. See ~/.config/mango/gaming.conf."
    echo "   • mango has no xwayland force_zero_scaling, so run XWayland games on"
    echo "     a fractionally-scaled output under native-res gamescope to stay sharp."
fi
echo "➡️  Next: reboot → SDDM → Mango. Then: sudo tailscale up (if new machine)."
