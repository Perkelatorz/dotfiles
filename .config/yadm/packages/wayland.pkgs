# Shared Wayland desktop stack — everything between "TTY" and "usable session"
# that is NOT the compositor itself. mango-specific bits live in mango.pkgs.
#
# Everything here is in the official Arch repos, so this list installs unchanged
# on plain Arch and on CachyOS. Only mango.pkgs and the gaming/class lists reach
# for packages outside Arch (see README.md, "Portability").

# --- Login (bootstrap enables sddm.service; takes effect on reboot) ---
sddm

# --- Session helpers (compositor-agnostic despite the hypr* names) ---
# hypridle drives ext-idle-notify-v1, a generic wlroots protocol mango
# implements too. mango runs it with its own timer file (mango/idle.conf)
# because the default one shells out to hyprctl.
#
# There is deliberately NO lock package. The shell locks itself:
# quickshell/LockScreen.qml drives ext-session-lock-v1 via WlSessionLock and
# authenticates through PamContext against /etc/pam.d/login. Both callers
# (mango/idle.conf and the bar's power menu) run `qs ipc call lock lock`, so
# hyprlock/swaylock are not installed and have no config to drift.
hypridle
hyprpicker
hyprpolkitagent

# --- Portals (file pickers; the screencast backend is in mango.pkgs) ---
xdg-desktop-portal-gtk

# --- Audio (a no-desktop install ships no audio stack) ---
pipewire
pipewire-alsa
pipewire-pulse
wireplumber
pavucontrol
playerctl

# --- Bluetooth ---
bluez
bluez-utils
blueman

# --- Wallpaper daemon (select-wallpaper.sh; autostarted as awww-daemon) ---
awww

# --- Wayland utils ---
wl-clipboard
wl-clip-persist
cliphist
grim
slurp
brightnessctl

# --- Runtime deps of ~/.config/scripts/* ---
# jq: _compositor.sh, screen-off.sh, screenshot-fullscreen.sh parse compositor
#     JSON with it. It used to arrive only as another package's dependency,
#     which would silently break those scripts if that package ever went away.
# python: alt-tab-cycle.sh sorts the window list in python3.
jq
python

# --- Bar / shell ---
# No notification daemon: quickshell owns org.freedesktop.Notifications itself
# (quickshell/NotificationService.qml wraps Quickshell.Services.Notifications).
# swaync used to be here and is now a conflict — two daemons race for the bus
# name and whichever loses silently shows nothing.
quickshell
qt6-wayland
qt6ct
qt5ct
kvantum
wdisplays
nwg-displays          # GUI display layout editor (wdisplays is live-only, can't save). Hyprland-oriented, but it writes a plain monitor list that mango/monitors.conf is hand-maintained from.

# --- Runtime deps of the quickshell bar ---
# Each backs a specific widget; without it the widget renders empty rather than
# failing loudly, so they are declared here instead of being left to chance.
# upower                 UPower service -> BatteryContent (charge, rate, health)
# lm_sensors             `sensors -j`   -> SystemContent temperature readout
# network-manager-applet `nm-connection-editor` -> NetworkContent's editor button
# cups / cups-filters    `lpstat`       -> SystemContent printer + job count
upower
lm_sensors
network-manager-applet
cups
cups-filters

# --- Theming (matugen pipeline + GTK/icons) ---
matugen
rofi
libnotify
imagemagick
papirus-icon-theme
adw-gtk-theme
# capitaine-cursors: named by gtk-3.0/settings.ini. It used to arrive only as a
# dependency of CachyOS's desktop profile, so removing that profile would have
# left the cursor theme dangling.
capitaine-cursors

# --- Fonts (a no-desktop install has NO fonts; noto covers UI + emoji fallback) ---
noto-fonts
noto-fonts-emoji
ttf-jetbrains-mono-nerd
ttf-firacode-nerd

# --- Terminal ---
kitty

# --- Secrets / keyring ---
gnome-keyring
libsecret
