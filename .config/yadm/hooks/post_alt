#!/bin/bash
# Runs after every `yadm alt` (including yadm's auto-alt on clone/pull/checkout).
#
# yadm rewrites alternates in place (yadm.alt-copy is set by bootstrap), but a
# pull that changes a sourced config still leaves the running compositor on the
# old parse. mango sources several files (monitors/env/binds/autostart/gaming/
# matugen-colors), so a reload after alt keeps the live session honest.
#
# No-ops when mango is not running, so this is safe on a headless pull.

if command -v mmsg &>/dev/null; then
    # The socket is named after the compositor pid. Do NOT try to read it out of
    # mango's own /proc/<pid>/environ: that is a snapshot taken at exec, before
    # mango setenv()s MANGO_INSTANCE_SIGNATURE, so it is stale or absent.
    msock="${MANGO_INSTANCE_SIGNATURE:-}"
    if [[ -z "$msock" || ! -S "$msock" ]]; then
        mpid=$(pgrep -x mango 2>/dev/null | head -1)
        [[ -n "$mpid" ]] && msock="${XDG_RUNTIME_DIR:-/run/user/$UID}/mango-${mpid}.sock"
    fi
    if [[ -n "$msock" && -S "$msock" ]]; then
        MANGO_INSTANCE_SIGNATURE="$msock" mmsg dispatch reload_config >/dev/null 2>&1 || true
    fi
fi

exit 0
